  "known_risks": [
    {
      "id": "M0-RISK-001",
      "risk": "Local HTTP remains in use.",
      "blocks_m0": false,
      "mitigation": "Loopback-only binding with Host, CORS, CSRF, CSP, and proxy-header controls.",
      "follow_up": "A dedicated security task before remote, LAN, or product distribution support."
    },
    {
      "id": "M0-RISK-002",
      "risk": "Sessions are stored in process memory and are lost on restart.",
      "blocks_m0": false,
      "mitigation": "The session is explicitly not a user login; cookie, CSRF, expiry, and capacity behavior are tested.",
      "follow_up": "Identity and persistent-session stage."
    },
    {
      "id": "M0-RISK-003",
      "risk": "Reparse-point checks have a theoretical same-user concurrent replacement TOCTOU window.",
      "blocks_m0": false,
      "mitigation": "Operations stay in owned isolated roots, check before and after access, fail on reparse points, and do not elevate.",
      "follow_up": "Further hardening with file, backup, or installer capabilities."
    },
    {
      "id": "M0-RISK-004",
      "risk": "A small race window exists between port probing and binding.",
      "blocks_m0": false,
      "mitigation": "Services bind only to loopback and fail safely if binding loses the race.",
      "follow_up": "Single-instance and startup-coordination task."
    },
    {
      "id": "M0-RISK-005",
      "risk": "Static AST and regular-expression security gates cannot replace runtime testing.",
      "blocks_m0": false,
      "mitigation": "Layered unit, negative, smoke, and browser E2E tests are also required.",
      "follow_up": "Continue runtime, fuzz, and static-analysis coverage in later tasks."
    },
    {
      "id": "M0-RISK-006",
      "risk": "FastAPI and Starlette TestClient emit a non-blocking upstream deprecation warning.",
      "blocks_m0": false,
      "mitigation": "Current locked dependencies are compatible and all 374 backend and architecture tests pass.",
      "follow_up": "Dependency-maintenance task following the upstream migration path."
    },
    {
      "id": "M0-RISK-007",
      "risk": "Comprehensive Windows ACL governance is not implemented.",
      "blocks_m0": false,
      "mitigation": "Current-user probes, reparse-point defenses, and the no-elevation boundary are verified without an excessive security claim.",
      "follow_up": "ACL threat model during file, backup, or installer work."
    },
    {
      "id": "M0-RISK-008",
      "risk": "Backup and restore are not implemented.",
      "blocks_m0": false,
      "mitigation": "M0 contains no business data and exposes no fake backup capability.",
      "follow_up": "Dedicated backup-and-restore task."
    },
    {
      "id": "M0-RISK-009",
      "risk": "A single-instance lock is not implemented.",
      "blocks_m0": false,
      "mitigation": "Port conflicts fail safely; WAL, busy timeout, and strict owned-process cleanup are in place.",
      "follow_up": "Resolve before formal product runtime or installer work."
    },
    {
      "id": "M0-RISK-010",
      "risk": "Business data and business functionality are not implemented.",
      "blocks_m0": false,
      "mitigation": "The reality matrix contains only FND-001 through FND-004 and explicitly states the limitation.",
      "follow_up": "Stage 1 begins only through an independently authorized DEV-1.x task."
    }
  ],
